{
  "name": "tintek-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:ssr && npm run prerender && node generate-sitemap.cjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir dist-ssr",
    "prerender": "node scripts/prerender-ssr.js",
    "prerender:legacy": "node scripts/prerender.js",
    "lint": "eslint .",
    "test:quotes": "node --test tests/quoteServices.test.js",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "start": "node src/backend/Server.js"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.0",
    "@fortawesome/fontawesome": "^1.1.8",
    "@mui/icons-material": "^6.4.12",
    "@mui/material": "^6.4.2",
    "@react-three/drei": "^9.121.4",
    "@react-three/fiber": "^8.17.14",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-levenshtein": "^3.0.0",
    "framer-motion": "^12.0.6",
    "fs": "^0.0.1-security",
    "lucide-react": "^0.486.0",
    "mongoose": "^8.13.2",
    "node-fetch": "^3.3.2",
    "openai": "^4.82.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.4.0",
    "react-router-dom": "^7.1.3",
    "react-swipeable": "^7.0.2",
    "sitemap-generator": "^8.5.1",
    "swiper": "^11.2.4",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "gh-pages": "^6.3.0",
    "globals": "^15.14.0",
    "puppeteer": "^24.40.0",
    "vite": "^6.0.5"
  }
}
